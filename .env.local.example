# Copy to .env.local and fill in from your Supabase project's
# Settings → API page. Both are safe to expose to the browser: the anon key
# is constrained by the RLS policies in supabase/schema.sql, not secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
